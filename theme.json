{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "980px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#f7f6f3"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#1c1d21"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#75777f"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#4f5bd5"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e6e3dd"
        }
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", Georgia, serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
        }
      ]
    }
  }
}