{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#f7f6f2"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#182821"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#53645a"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#245f46"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#d9dfd7"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Small",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "Medium",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "Large",
          "size": "3rem"
        },
        {
          "slug": "80",
          "name": "Extra large",
          "size": "clamp(3rem, 8vw, 7rem)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.5rem"
        },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "2.5rem"
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "4.5rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 4vw, 3rem)",
        "right": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.75"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "-0.035em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "button": {
        "border": {
          "radius": "8px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|surface"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.5rem",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|ink"
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var:preset|color|ink"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "1rem"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank canvas",
      "postTypes": [
        "page"
      ]
    }
  ]
}
